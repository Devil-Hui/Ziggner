classDiagram
    %% ============ Django Auth User ============
    class User {
        +string username
        +string email
        +string first_name
        +string last_name
        +bool is_active
        +bool is_superuser
        +set_password(pw)
        +check_password(pw)
    }

    %% ============ UserProfile (增量扩展) ============
    class UserProfile {
        +User user
        +string country_code
        +string phone
        +string account_no
        +string security_stamp
        +string department  %% NEW
        +bool email_verified  %% NEW
        +text note  %% NEW
        +string locale  %% NEW
        +bool must_reset_password  %% NEW
        +full_phone() string
    }
    User "1" *-- "1" UserProfile : OneToOne

    %% ============ RBAC ============
    class UserRole {
        +int user_id
        +string role
        +User granted_by
    }

    %% ============ EmailTemplate ============
    class EmailTemplate {
        +string template_type
        +string subject
        +text html_body
        +text text_body
        +bool is_active
        +render(context) dict
    }

    %% ============ 校验层 ============
    class Validators {
        +USERNAME_REGEX
        +validate_username(v)
        +validate_email(v)
        +validate_password(v)
    }

    %% ============ Serializer ============
    class AdminCreateSerializer {
        +username / password / email
        +first_name / last_name / role
        +country_code / phone / department
        +is_active / note / locale
        +validate()
    }

    %% ============ Service 层 ============
    class UserService {
        +create_user(username, password, email, first_name, last_name, department, country_code, phone, is_active, note, locale, must_reset_password, email_verified) User
    }

    %% ============ View 层 ============
    class AdminUserCreateView {
        +post(request) 201
    }
    class AdminEmailVerifyView {
        +post(request) 200  %% 公开端点
    }

    %% ============ Email / Celery ============
    class EmailService {
        +issue_admin_email_verify_token(user) str
        +decode_admin_email_verify_token(token) str
        +send_admin_welcome_email(user, context)
    }
    class SendAdminWelcomeEmailTask {
        +send_admin_welcome_email.delay(user_id)
    }

    %% ============ 关系 ============
    AdminUserCreateView ..> AdminCreateSerializer : 校验
    AdminUserCreateView ..> UserService : 落库
    UserService ..> User : create_user
    UserService ..> UserProfile : create
    AdminUserCreateView ..> UserRole : get_or_create(role)
    AdminUserCreateView ..> SendAdminWelcomeEmailTask : on_commit.delay
    SendAdminWelcomeEmailTask ..> EmailService : send_admin_welcome_email
    EmailService ..> EmailTemplate : render(admin_welcome)
    AdminEmailVerifyView ..> EmailService : decode token
    AdminEmailVerifyView ..> UserProfile : set email_verified=true
    Validators <.. AdminCreateSerializer : 复用
    Validators <.. UserService : 复用(register 共用)
