{
  "name": "ziggner-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 12700",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0 --port 12700",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:audit": "audit-ci --config .audit-ci.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "agent-base": "^9.0.0",
    "axios": "^1.7.9",
    "browser-image-compression": "2.0.2",
    "http-proxy-agent": "^9.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.2",
    "react-virtuoso": "^4.18.10",
    "styled-components": "^6.1.0",
    "@fontsource/playfair-display": "^5.2.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "audit-ci": "^7.1.0",
    "babel-plugin-styled-components": "^2.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "javascript-obfuscator": "^5.5.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  }
}
