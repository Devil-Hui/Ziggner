# Cloudflare Workers 部署 —— 前端静态资源由 Cloudflare 托管
# 后端 API 在本机，通过 Cloudflare Tunnel (HTTPS) 暴露

VITE_API_URL=https://api.ziggner.com/api/v1
# WebSocket 必须走 api.ziggner.com（Cloudflare Pages 不转发 WS，同源 wss://admin.ziggner.com 不可行）。
# 页面来自 Pages 无 connect-src CSP 限制，实测 wss://api.ziggner.com/ws/ 握手 101 成功。
VITE_WS_URL=wss://api.ziggner.com
# 生产环境关闭支付模拟器（仅开放 PayPal + Stripe 真实收款）
VITE_ENABLE_MOCK_PAYMENT=false
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEKD3ptov-9Xwnjy

# 本地开发不需要这些变量（自动走 localhost:8000）
