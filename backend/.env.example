# =============================================================================
# Ziggner 环境变量模板
# 复制本文件为 .env 并填入实际值。切勿将 .env 提交到版本控制。
# =============================================================================
#   cp .env.example .env
# =============================================================================

# ── Django ──────────────────────────────────────────────────────────────────
# 运行环境：local | dev | prod
# CLI(manage.py) 未设时默认 local；wsgi/asgi/celery 未设时默认 prod（fail-closed）
# Docker / CI 必须显式注入，不要依赖默认值。历史别名 DEL_ENV 仍可读，优先 DJANGO_ENV。
DJANGO_ENV=local

# 生产环境请使用 openssl rand -hex 32 生成强密钥
DJANGO_SECRET_KEY=change-this-to-a-random-64-char-string

# ── 数据库 ──────────────────────────────────────────────────────────────────
DB_NAME=backend
DB_USER=admin
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=change-this-too

# ── Redis ───────────────────────────────────────────────────────────────────
# DEPRECATED (MySQL-only): Redis 已移除，可留空
# REDIS_MASTER_URL=redis://:change-this-password@127.0.0.1:6379
# REDIS_PASSWORD=change-this-password

# ── RabbitMQ ────────────────────────────────────────────────────────────────
# DEPRECATED (MySQL-only): RabbitMQ 已移除
# RABBITMQ_DEFAULT_USER=admin
# RABBITMQ_DEFAULT_PASS=change-this-mq-password

# ── 邮件（163 邮箱示例） ────────────────────────────────────────────────────
EMAIL_HOST_USER=your-email@163.com
# 163邮箱需使用「授权码」而非登录密码
EMAIL_HOST_PASSWORD=your-authorization-code

# ── 支付 ────────────────────────────────────────────────────────────────────
# Mock 支付（开发/测试用支付模拟器）：
# 生产环境（DJANGO_ENV=prod）强制禁用，即使设为 true 也忽略。
# 非生产环境默认开启；但必须显式配置独立签名密钥 MOCK_PAYMENT_SECRET，
# 未配置时 Mock 支付会被禁用（fail-closed）。密钥绝不回退到 DJANGO_SECRET_KEY。
ENABLE_MOCK_PAYMENT=true
MOCK_PAYMENT_SECRET=change-this-to-a-random-64-char-string

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-webhook-id

# 支付宝
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key

# 支付安全/体验配置
# 待支付订单有效期（分钟）：超过后允许用户重新发起支付（旧 pending 标记为取消）
PAYMENT_PENDING_TTL_MINUTES=15
# 状态查询节流（秒）：同一支付在间隔内不重复调用网关查询，防 DoS / 防网关限流
PAYMENT_GATEWAY_QUERY_INTERVAL=30
# 最大待支付时长（分钟）：超过后视为用户放弃，标记为 CANCELLED，避免无限轮询网关（防死循环）
PAYMENT_MAX_PENDING_MINUTES=1440
# UNKNOWN 退款对账最大重试次数：超过后标记为 FAILED，防止网关持续异常时无限重试（防死循环）
REFUND_RECONCILIATION_MAX_ATTEMPTS=5

# ── 社交登录 ────────────────────────────────────────────────────────────────
SOCIAL_AUTH_GOOGLE_CLIENT_ID=your-google-client-id
SOCIAL_AUTH_GOOGLE_SECRET=your-google-secret

SOCIAL_AUTH_FACEBOOK_APP_ID=your-fb-app-id
SOCIAL_AUTH_FACEBOOK_SECRET=your-fb-secret

# ── 文件存储 ────────────────────────────────────────────────────────────────
FILE_STORAGE=local
# 公网媒体域名（local 存储时上传返回公网 URL，避免 127.0.0.1 回环）
PUBLIC_MEDIA_URL=https://api.ziggner.com
# Cloudflare R2（使用 FILE_STORAGE=r2 时配置）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ziggner-r2
R2_PUBLIC_URL=https://cdn.ziggner.com

# ── 前端 ────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── 生产环境 ────────────────────────────────────────────────────────────────
# DJANGO_ENV=prod
# ALLOWED_HOSTS=example.com,www.example.com
# CORS_ORIGINS=https://example.com,https://www.example.com
