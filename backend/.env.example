# =============================================================================
# Ziggner 环境变量模板
# 复制本文件为 .env 并填入实际值。切勿将 .env 提交到版本控制。
# =============================================================================
#   cp .env.example .env
# =============================================================================

# ── Django ──────────────────────────────────────────────────────────────────
# 生产环境请使用 openssl rand -hex 32 生成强密钥
DJANGO_SECRET_KEY=change-this-to-a-random-64-char-string

# ── 数据库 ──────────────────────────────────────────────────────────────────
DB_NAME=backend
DB_USER=admin
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=change-this-too

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_MASTER_URL=redis://:change-this-password@127.0.0.1:6379
REDIS_PASSWORD=change-this-password

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-this-mq-password

# ── 邮件（163 邮箱示例） ────────────────────────────────────────────────────
EMAIL_HOST_USER=your-email@163.com
# 163邮箱需使用「授权码」而非登录密码
EMAIL_HOST_PASSWORD=your-authorization-code

# ── 支付 ────────────────────────────────────────────────────────────────────
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-webhook-id

# 支付宝
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key

# ── 社交登录 ────────────────────────────────────────────────────────────────
SOCIAL_AUTH_GOOGLE_CLIENT_ID=your-google-client-id
SOCIAL_AUTH_GOOGLE_SECRET=your-google-secret

SOCIAL_AUTH_FACEBOOK_APP_ID=your-fb-app-id
SOCIAL_AUTH_FACEBOOK_SECRET=your-fb-secret

# ── 文件存储 ────────────────────────────────────────────────────────────────
FILE_STORAGE=local
# Cloudflare R2（使用 FILE_STORAGE=r2 时配置）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ziggner-media
R2_PUBLIC_URL=

# ── 前端 ────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── 生产环境 ────────────────────────────────────────────────────────────────
# DJANGO_ENV=prod
# ALLOWED_HOSTS=example.com,www.example.com
# CORS_ORIGINS=https://example.com,https://www.example.com
