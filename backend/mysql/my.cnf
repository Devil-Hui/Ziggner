[mysqld]
# ============================================
# Ziggner MySQL 数据库配置
# 版本: v1.0 | MySQL 8.0.36
# 容器限制: 384MB 内存 / 0.25 CPU
# 数据目录: /var/lib/mysql
# 配置文件: /etc/mysql/conf.d/my.cnf (只读挂载)
# ============================================

# ──── 字符集 ────
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ──── 连接配置 ────
max_connections = 50
thread_cache_size = 8
max_connect_errors = 100
wait_timeout = 600
interactive_timeout = 600

# ──── InnoDB 引擎优化 (384MB 容器限制) ────
# 内存: buffer_pool 占用大部分内存
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
innodb_sort_buffer_size = 2M
innodb_ft_cache_size = 8M
# 每个表独立表空间文件（便于管理）
innodb_file_per_table = ON
# 事务提交: 2=每秒刷盘（性能优先，最多丢失1秒数据）
innodb_flush_log_at_trx_commit = 2
# 直接 I/O,绕过文件系统缓存
innodb_flush_method = O_DIRECT
# 磁盘 IO 能力（HDD=200, SSD=2000）
innodb_io_capacity = 200
innodb_io_capacity_max = 400
# 自适应哈希索引
innodb_adaptive_hash_index = ON
# 后台IO线程数
innodb_read_io_threads = 4
innodb_write_io_threads = 4
# 清理线程
innodb_purge_threads = 2
# 日志文件大小
innodb_log_file_size = 64M
innodb_log_files_in_group = 2

# ──── 临时表配置 ────
# 默认临时目录（可修改到独立磁盘）
tmpdir = /tmp
# 内存临时表上限，超过则写入磁盘
tmp_table_size = 16M
max_heap_table_size = 16M
# InnoDB 临时表空间文件
innodb_temp_data_file_path = ibtmp1:12M:autoextend:max:512M

# ──── 查询缓存与优化 ────
table_open_cache = 200
table_definition_cache = 200
# 排序缓冲区（每个连接分配）
sort_buffer_size = 256K
# 连接缓冲区
join_buffer_size = 256K
# 读取缓冲区
read_buffer_size = 256K
read_rnd_buffer_size = 512K

# ──── 二进制日志（用于时间点恢复和数据同步）────
# 开启二进制日志，存储到 /var/lib/mysql/binlog/
log_bin = /var/lib/mysql/binlog/ziggner-bin
# binlog 格式: ROW 最安全，支持时间点恢复
binlog_format = ROW
# 每个 binlog 文件最大 100MB
max_binlog_size = 100M
# binlog 保留 7 天（生产环境建议 14-30 天）
binlog_expire_logs_seconds = 604800
# 事务同步到 binlog：1=每次提交都刷盘（最安全）
sync_binlog = 1
# 跳过从库的 binlog 写入（无主从时开启减少 IO）
disable_log_bin = OFF

# ──── 慢查询日志 ────
slow_query_log = ON
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = ON

# ──── 通用日志 ────
# 生产环境建议关闭，仅在调试时开启
general_log = OFF
general_log_file = /var/log/mysql/general.log

# ──── 时区 ────
default-time-zone = +08:00

# ──── 安全性 ────
# 本地连接跳过密码（仅限套接字连接）
skip-external-locking
# 本地文件导入导出限制
local-infile = OFF
# 符号链接禁用
symbolic-links = 0

# ──── 连接元数据 ────
# 记录慢查询的元数据到 mysql.slow_log 表
log_output = FILE

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqldump]
# 导出备份时使用 utf8mb4
default-character-set = utf8mb4
max_allowed_packet = 16M
