# Environment files
.env
.env.*
!.env.example
!web/react/.env.production
secrets.json
# 本机 tunnel 自签证书（敏感，不入库）
deploy/nginx-certs/
# 敏感证书（真实 TLS 私钥，严禁入库）
certs/

# 测试/验证残留（不允许上传）
backend/_*_test.py
backend/test/
web/react/test/
web/react/probe_chunk.js
web/react/scripts_tmp_rm_pb.py
web/react/overview-*.md
web/react/dist_*/
# 本地构建改名残留（sandbox safe-delete 规避用）
web/react/dist-old/
# git 仓库损坏备份目录（不入库）
.git.broken-*/
# coverage 二进制数据
backend/.coverage
# 覆盖率 JSON 中间产物
backend/coverage*.json
backend/.pytest_cache/
backend/allure-results/
backend/allure-report/

# Node
node_modules/
web/react/node_modules/
.wrangler/
web/react/.wrangler/
backend/.wrangler/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Build output & artifacts
dist/
.webpack/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Logs
*.log
logs/

# Media (user uploaded files)
web/react/dist/
web/react/dist_verify/
# Vite 构建前的临时重命名产物（dist-archive-* / dist-old-* 等）一律忽略
web/react/dist-*/
backend/media/
backend/static/

# Python caches (in case backend/.gitignore misses)
*.pyc
__pycache__/

# 监控凭据（SMTP/钉钉 webhook，绝不入库）
deploy/monitoring/.env.monitoring
deploy/monitoring/smtp_password
