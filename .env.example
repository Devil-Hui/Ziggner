# ============================================================
# Ziggner 环境变量示例模板（.env.example）
# ------------------------------------------------------------
# 用法：复制本文件为 .env（本地）或 .env.production（公网），
#       再填入真实值。本文件不含任何真实凭证，可安全入库。
# 注意：所有 *_KEY / *_SECRET / DATABASE_URL 含密码的项，
#       真实值切勿提交到仓库（.env / .env.production 已被 gitignore）。
# ============================================================

# === 基础 ===
DEBUG=false
# Django 密钥：生产必须用强随机值，可通过 `python -c "import secrets;print(secrets.token_urlsafe(50))"` 生成
SECRET_KEY=your-django-secret-key-here
# 允许的跨域来源（逗号分隔），本地前端一般为 http://localhost:12700
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:12700
CSRF_TRUSTED_ORIGINS=https://your-domain.com
# 数据库（MySQL）
DATABASE_URL=mysql://user:password@127.0.0.1:3306/ziggner
# Redis（channel layer / celery）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# === Cloudflare R2 对象存储（媒体 / 上传）===
# 桶名与自定义域名请替换为你的实际值；下方均为占位示例，非真实凭证
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# 桶名示例（请勿填真实桶名到仓库；真实值写在 .env / .env.production）
R2_BUCKET=your-r2-bucket-name
# 自定义 CDN 域名示例，用于根治回环地址 Mixed Content
R2_PUBLIC_URL=https://your-cdn-domain.com

# === Stripe 支付（Webhook 验签必需）===
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# === 邮件服务（可选）===
EMAIL_HOST=smtp.your-provider.com
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password

# === 前端公开变量（仅 web/react/.env.production，VITE_ 前缀，公网可见）===
# VITE_API_BASE=/api
